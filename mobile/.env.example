# URL de base de l'API backend ASP.NET Core
# Remplacez par l'adresse IP locale de votre machine (évitez 'localhost' car le smartphone/émulateur a son propre réseau)
# Exemples :
# - Émulateur Android officiel : http://10.0.2.2:5000/api
# - Smartphone réel en Wi-Fi / Hotspot : http://192.168.1.XX:5000/api
API_URL=http://<VOTRE_ADRESSE_IP_LOCALE>:5000/api
